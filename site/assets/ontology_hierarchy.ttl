@prefix ontology: <https://w3id.org/vord#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

vord:burstValue rdfs:domain vord:RateRestriction .
vord:burstValue rdfs:range xsd:integer .
vord:ConcurrentRequestsRestriction rdfs:subClassOf vord:Restriction .
vord:costModel rdfs:domain vord:CostModelRestriction .
vord:costModel rdfs:range vord:CostModel .
vord:CostModelRestriction rdfs:subClassOf vord:Restriction .
vord:enforcement rdfs:domain vord:Restriction .
vord:enforcement rdfs:range vord:EnforcementMode .
vord:hardRestriction rdfs:domain vord:Restriction .
vord:hardRestriction rdfs:range xsd:boolean .
vord:hasRestriction rdfs:domain sd:Service .
vord:hasRestriction rdfs:range vord:Restriction .
vord:hasScope rdfs:domain vord:Restriction .
vord:hasScope rdfs:range vord:Scope .
vord:httpSignalHeader rdfs:domain vord:Restriction .
vord:httpSignalHeader rdfs:range http:HeaderName .
vord:maxValue rdfs:domain vord:Restriction .
vord:maxValue rdfs:range xsd:integer .
vord:metric rdfs:domain vord:Restriction .
vord:metric rdfs:range vord:Metric .
vord:minValue rdfs:domain vord:Restriction .
vord:minValue rdfs:range xsd:integer .
vord:QuotaRestriction rdfs:subClassOf vord:Restriction .
vord:RateRestriction rdfs:subClassOf vord:Restriction .
vord:ResponseTimeRestriction rdfs:subClassOf vord:Restriction .
vord:Restriction rdfs:subClassOf sd:Feature .
vord:ResultSizeRestriction rdfs:subClassOf vord:Restriction .
vord:retryAfterHint rdfs:domain vord:Restriction .
vord:retryAfterHint rdfs:range xsd:duration .
vord:returnsStatusCode rdfs:domain vord:Restriction .
vord:returnsStatusCode rdfs:range xsd:integer .
vord:ServerLoadRestriction rdfs:subClassOf vord:Restriction .
vord:unit rdfs:domain vord:Restriction .
vord:unit rdfs:range qudt:Unit .
vord:windowDuration rdfs:domain vord:Restriction .
vord:windowDuration rdfs:range xsd:duration .